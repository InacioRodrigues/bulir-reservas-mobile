# URL base da API do Desafio 1 (sem barra final e sem /api/v1).
# - Expo web / simulador iOS no mesmo Mac: http://localhost:3000
# - Emulador Android: http://10.0.2.2:3000
# - Telemóvel físico com Expo Go: http://<IP-da-máquina-na-rede-local>:3000 (ex.: http://192.168.1.20:3000)
# - Produção: https://<api-em-producao>
EXPO_PUBLIC_API_URL=http://localhost:3000

# Mostra no login atalhos para as contas de demonstração do seed da API (true/false).
EXPO_PUBLIC_DEMO_ACCOUNTS=true
