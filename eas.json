{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://SUBSTITUIR-PELA-API-EM-PRODUCAO",
        "EXPO_PUBLIC_DEMO_ACCOUNTS": "true"
      }
    },
    "production": {
      "android": { "buildType": "app-bundle" }
    }
  }
}
